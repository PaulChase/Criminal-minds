{
	"expo": {
		"name": "Criminal Minds",
		"slug": "CriminalMinds",
		"version": "1.2.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "dark",
		"backgroundColor": "#0d0d0d",
		"ios": {
			"bundleIdentifier": "com.paulstack.criminalminds",
			"supportsTablet": false
		},
		"android": {
			"package": "com.paulstack.criminal_minds",
			"versionCode": 3,
			"adaptiveIcon": {
				"foregroundImage": "./assets/icon.png",
				"backgroundColor": "#000000"
			},
			"blockedPermissions": [
				"android.permission.READ_MEDIA_IMAGES",
				"android.permission.READ_MEDIA_VIDEO",
				"android.permission.READ_MEDIA_AUDIO",
				"android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
				"android.permission.READ_EXTERNAL_STORAGE"
			]
		},
		"plugins": [
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#0d0d0d"
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
					"savePhotosPermission": "Allow $(PRODUCT_NAME) to save quote cards to your photo library.",
					"isAccessMediaLocationEnabled": false,
					"granularPermissions": [
						"photo"
					]
				}
			],
			"expo-font",
			"expo-asset"
		],
		"extra": {
			"eas": {
				"projectId": "d03e41df-b147-4c02-b98e-f4128da65ae0"
			}
		}
	}
}
