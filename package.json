{
  "name": "criminal-minds",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/generate-character-images.mjs",
    "images:check": "node scripts/generate-character-images.mjs --check",
    "build:dev": "eas build --platform all --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:ios-sim": "eas build -p ios --profile development-simulator",
    "build:preview": "eas build --platform all --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:ios:simulator": "eas build --platform ios --profile preview-simulator",
    "build:testflight:preview": "eas build --platform ios --profile preview-testflight --auto-submit-with-profile production",
    "build:prod": "eas build --platform all --profile production",
    "build:prod:android": "eas build --platform android --profile production",
    "build:prod:ios": "eas build --platform ios --profile production",
    "build:prod:apk": "eas build --platform android --profile production-apk",
    "build:prod:submit": "eas build --platform all --profile production --auto-submit",
    "build:prod:android:submit": "eas build --platform android --profile production --auto-submit",
    "build:prod:ios:submit": "eas build --platform ios --profile production --auto-submit",
    "build:testflight:production": "eas build --platform ios --profile production --auto-submit",
    "update:preview": "eas update --channel preview --environment preview",
    "update:prod": "eas update --channel production --environment production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "2.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
