{
	"cli": {
		"version": ">= 16.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development",
			"environment": "development"
		},
		"development-simulator": {
			"extends": "development",
			"ios": {
				"simulator": true
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"channel": "preview",
			"environment": "preview"
		},
		"production": {
			"channel": "production",
			"environment": "production"
		}
	},
	"submit": {
		"production": {}
	}
}
